{
  "name": "dsh-notification-gotify",
  "description": "Gotify push notifications for the DeepSeek Harness: the host pushes a message when a task completes, fails, is interrupted, or asks you a question — no browser needed.",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-session": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../vendor/cordis",
    "@deepseek-ai/dsh-session": "link:../../packages/core/session",
    "@deepseek-ai/dsh-llm": "link:../../packages/llm/llm",
    "@deepseek-ai/schemastery": "link:../../vendor/schemastery",
    "@deepseek-ai/dsh-typert-registry": "link:../../packages/typert/registry",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.27.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
